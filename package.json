{
  "name": "koupa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "css-tree": "^1.1.3",
    "expo": "~57.0.8",
    "expo-auth-session": "~57.0.5",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.9",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.12.1",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest-expo": "~57.0.2",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm run typecheck && npm test",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@react-navigation|@expo|expo(nent)?|expo-[^/]+|expo-modules-core)/)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "private": true
}
