# Select dev, staging, or production for local builds.
EXPO_PUBLIC_APP_ENV=development

# Optional for a deployed Expo web build. Use the exact public callback URL,
# for example https://app.example.com/callback. Leave unset for local web/Expo Go.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Firebase client configuration for the selected environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Supabase client configuration for the selected environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
