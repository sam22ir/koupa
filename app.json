{
  "expo": {
    "name": "Koupa",
    "slug": "koupa",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "scheme": "koupa",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.koupa.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon-foreground.png",
        "monochromeImage": "./assets/brand/app-icon-foreground.png",
        "backgroundColor": "#1A7A78"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "5a9aa731-afd2-4d66-849b-62265ab130f9"
      }
    },
    "owner": "sam22ir"
  }
}
